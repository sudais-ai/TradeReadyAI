# ==============================================================================
# TradeReady AI - Production Environment Configuration Template
# ==============================================================================
# ⚠️ WARNING: Never commit real secrets to source control.
# Copy this file to `.env` or configure these variables in your deployment platform.

# ------------------------------------------------------------------------------
# 1. DATABASE (Required)
# ------------------------------------------------------------------------------
# Must be a PostgreSQL connection string.
# Example: postgresql://user:password@localhost:5432/tradeready?schema=public
DATABASE_URL=""

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION (Required)
# ------------------------------------------------------------------------------
# Cryptographically secure secret for JWT signing and NextAuth.
# Generate via: openssl rand -base64 32
AUTH_SECRET=""

# Required for NextAuth in production
AUTH_TRUST_HOST="true"

# ------------------------------------------------------------------------------
# 3. AI / LLM PIPELINE (Required)
# ------------------------------------------------------------------------------
# API Key for Opencode Zen or designated AI provider.
OPENCODE_ZEN_API_KEY=""

# ------------------------------------------------------------------------------
# 4. CLOUD STORAGE (Required for Production)
# ------------------------------------------------------------------------------
# AWS S3 compatible credentials for document persistence.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
AWS_BUCKET_NAME=""

# ------------------------------------------------------------------------------
# 5. EMAIL / SMTP (Required for Password Resets)
# ------------------------------------------------------------------------------
# Credentials for sending transactional emails.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@tradeready.ai"

# ------------------------------------------------------------------------------
# 6. OAUTH PROVIDERS (Optional)
# ------------------------------------------------------------------------------
# Leave blank to disable social login buttons.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
