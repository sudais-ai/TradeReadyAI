generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                       String    @id @default(uuid())
  email                    String    @unique
  name                     String?
  passwordHash             String?
  emailVerified            DateTime?
  emailVerificationToken   String?   @unique
  emailVerificationExpires DateTime?
  passwordResetToken       String?   @unique
  passwordResetExpires     DateTime?
  failedLoginAttempts      Int       @default(0)
  lockedUntil              DateTime?
  lastLoginAt              DateTime?
  passwordChangedAt        DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  tradeCases TradeCase[]
  sessions   Session[]
  auditLogs  AuditLog[]
}

model TradeCase {
  id             String  @id @default(uuid())
  status         String  @default("Draft")
  progress       String?
  nextAction     String?
  nextActionHref String?

  direction      String  @default("Export")
  origin         String
  destination    String
  shipmentDate   String?
  estimatedValue String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  product        Product?
  documents      Document[]
  requirements   Requirement[]
  evaluations    RequirementEvaluation[]
  processingJobs ProcessingJob[]

  // Phase 12: composite (userId, updatedAt DESC) supports the
  // dashboard "recent trade cases" query without a sort step.
  // The single-column index above is kept because other queries
  // (e.g. ownership checks) only filter on userId.
  //
  // Phase 13: deletedAt is added to the composite index so the
  // dashboard's "active cases" query is a single index seek.
  @@index([userId(sort: Desc), updatedAt(sort: Desc)], name: "TradeCase_userId_updatedAt_idx")
  @@index([userId, deletedAt], name: "TradeCase_userId_deletedAt_idx")
  @@index([userId])
}

model Product {
  id          String  @id @default(uuid())
  name        String
  description String?
  category    String?
  material    String?
  packaging   String?
  intendedUse String?
  origin      String?
  quantity    String?
  weight      String?

  tradeCaseId String    @unique
  tradeCase   TradeCase @relation(fields: [tradeCaseId], references: [id], onDelete: Cascade)
}

model Document {
  id          String  @id @default(uuid())
  name        String
  type        String?
  status      String  @default("Missing")
  description String?
  fileRef     String?
  mimeType    String?
  size        Int?

  processingStatus String?
  extractedText    String?
  processingError  String?
  processedAt      DateTime?

  embeddingStatus String?
  embeddingError  String?
  embeddedAt      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tradeCaseId String
  tradeCase   TradeCase @relation(fields: [tradeCaseId], references: [id], onDelete: Cascade)

  chunks         DocumentChunk[]
  processingJobs ProcessingJob[]

  // Phase 13: deletedAt composite index supports the per-case
  // "active documents" query. (The single-column index above is
  // kept for ownership checks and the trash list.)
  @@index([tradeCaseId, deletedAt], name: "Document_tradeCaseId_deletedAt_idx")
  @@index([tradeCaseId])
}

model DocumentChunk {
  id             String @id @default(uuid())
  documentId     String
  chunkIndex     Int
  content        String
  characterCount Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  embeddings DocumentChunkEmbedding[]
  evidences  EvaluationEvidence[]

  @@unique([documentId, chunkIndex])
}

model DocumentChunkEmbedding {
  id         String @id @default(uuid())
  chunkId    String
  provider   String
  model      String
  dimensions Int
  vector     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chunk DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@unique([chunkId, provider, model])
}

model Requirement {
  id     String  @id @default(uuid())
  title  String
  status String  @default("Needs review")
  source String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tradeCaseId String
  tradeCase   TradeCase @relation(fields: [tradeCaseId], references: [id], onDelete: Cascade)

  evaluation RequirementEvaluation?

  @@index([tradeCaseId])
}

model RequirementEvaluation {
  id            String @id @default(uuid())
  requirementId String @unique
  tradeCaseId   String

  status     String  @default("PENDING")
  summary    String?
  confidence Float?

  modelProvider String?
  modelName     String?
  error         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  tradeCase   TradeCase   @relation(fields: [tradeCaseId], references: [id], onDelete: Cascade)

  evidences EvaluationEvidence[]

  @@index([tradeCaseId])
}

model EvaluationEvidence {
  id           String @id @default(uuid())
  evaluationId String
  chunkId      String

  reason          String?
  relevanceScore  Float?
  contentSnapshot String?

  createdAt DateTime @default(now())

  evaluation RequirementEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  chunk      DocumentChunk         @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([evaluationId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Phase 13: AuditLog. A best-effort, append-only record of
// security-relevant mutations. Used for "log out other devices",
// "show me who accessed my account" surfaces, and post-incident
// forensics. Server-side authorization (userId filter on every read
// path) is the only access control — there is no admin role.
model AuditLog {
  id     String  @id @default(uuid())
  // null for system-initiated events (e.g. stale-job recovery).
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Stable, namespaced action name (e.g. "TRADE_CASE_DELETED",
  // "PASSWORD_CHANGED"). Always uppercase snake_case.
  action String

  // Target type (e.g. "TradeCase", "Document", "User", "Session").
  target String

  // Target id. For User.target this is the affected userId; for
  // TradeCase.target this is the tradeCaseId; etc.
  targetId String?

  // Free-form structured metadata. Never store secrets, passwords,
  // tokens, JWTs, or raw credentials here.
  metadata String?

  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([target, targetId])
  @@index([action, createdAt])
}

// Phase 13: persistent ProcessingJob. The durable record of every
// document-processing request. The in-process Phase 9 queue remains
// the executor; this table is the source of truth for status, attempts,
// errors, and recovery after a crash/restart.
//
// State machine: SCHEDULED → RUNNING → COMPLETED
//                                  ↘ FAILED
//                                  ↘ CANCELLED (parent case/document was
//                                                soft-deleted before run)
// RUNNING rows whose lockedAt is older than PROCESSING_LOCK_TIMEOUT_MS
// are reset to SCHEDULED on startup (stale recovery).
model ProcessingJob {
  id         String    @id @default(uuid())
  // The document being processed. ON DELETE SET NULL is chosen so
  // that a physical (hard) delete of a Document doesn't cascade
  // through the audit log; the ProcessingJob row stays for forensics.
  // Soft-deleted Documents remain in the DB and keep the FK.
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  tradeCaseId String?
  tradeCase   TradeCase? @relation(fields: [tradeCaseId], references: [id], onDelete: SetNull)

  // SCHEDULED | RUNNING | COMPLETED | FAILED | CANCELLED
  status String @default("SCHEDULED")

  // Number of worker attempts (1 = first run, 2 = retried once, etc).
  attempts Int @default(0)

  // Truncated error message from the most recent failed attempt.
  lastError String?

  // Earliest time the worker may start. Default = createdAt.
  scheduledFor DateTime @default(now())

  // Worker identity. Stable per worker. Set to "inproc" for the
  // single-process dev target. Multi-process deploys would use a
  // hostname/pid.
  lockedBy String?
  lockedAt DateTime?

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledFor])
  @@index([documentId])
  @@index([tradeCaseId])
  @@index([lockedBy, lockedAt])
}
